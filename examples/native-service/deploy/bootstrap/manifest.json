{
  "schema_version": "1.0",
  "kind": "service",
  "runtime": "systemd",
  "app": "example",
  "zone": "apps",
  "release_source": "acme/example",
  "release_channel": "stable",
  "current_version": "v1.2.3",
  "release_asset_pattern": "example-{version}-{platform}",
  "artifact": {
    "url": "https://github.com/acme/example/releases/download/v1.2.3/example-linux-amd64",
    "sha256": "REPLACE_WITH_RELEASE_SHA256"
  },
  "install_path": "/srv/nas/stacks/apps/example/releases/current/example",
  "service_name": "example",
  "stack_path": "/srv/nas/stacks/apps/example",
  "data_path": "/srv/nas/data/example",
  "secret_path": "/srv/nas/secrets/example.env",
  "secret_mount": "/run/example.env",
  "required_secrets": ["DATABASE_URL"],
  "generated_secrets": [],
  "healthcheck": {
    "url": "http://127.0.0.1:8080/health",
    "timeout_seconds": 10,
    "retries": 5
  },
  "migration_command": [],
  "postgres": {
    "mode": "shared",
    "cluster_name": "nas-main",
    "infrastructure_compose_path": "/srv/nas/stacks/infra/postgres/docker-compose.yml",
    "service_name": "postgres",
    "network_name": "nas-infra",
    "admin_user": "postgres",
    "admin_database": "postgres",
    "app_role": "example",
    "app_database": "example",
    "database_url_key": "DATABASE_URL",
    "role_password_key": "DATABASE_PASSWORD",
    "admin_secret_path": "/srv/nas/secrets/postgres.env",
    "admin_password_key": "POSTGRES_PASSWORD",
    "host": "postgres",
    "port": "5432",
    "postgres_major": "16"
  }
}
