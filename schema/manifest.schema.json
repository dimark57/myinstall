{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "app", "zone", "runtime", "stack_path", "data_path", "secret_path", "secret_mount", "required_secrets", "healthcheck"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "app": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "zone": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "image": {"type": "string"},
    "kind": {"type": "string"},
    "runtime": {"enum": ["native", "docker", "systemd", "launchd", "mixed", "none"]},
    "stack_path": {"type": "string"},
    "data_path": {"type": "string"},
    "secret_path": {"type": "string"},
    "secret_mount": {"type": "string"},
    "compose_source": {"type": "string"},
    "install_path": {"type": "string"},
    "service_name": {"type": "string"},
    "service_user": {"type": "string"},
    "working_directory": {"type": "string"},
    "install_command": {"type": "array", "items": {"type": "string"}},
    "upgrade_command": {"type": "array", "items": {"type": "string"}},
    "migration_command": {"type": "array", "items": {"type": "string"}},
    "artifact": {
      "type": "object",
      "required": ["url", "sha256"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "required_secrets": {"type": "array", "items": {"type": "string"}},
    "generated_secrets": {"type": "array", "items": {"type": "object", "required": ["name", "length"]}},
    "healthcheck": {"type": "object", "required": ["url"]},
    "postgres": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["shared", "private"]},
        "cluster": {"type": "string"},
        "admin_compose_path": {"type": "string"},
        "service": {"type": "string"},
        "role": {"type": "string"},
        "database": {"type": "string"},
        "role_password_key": {"type": "string"},
        "database_url_key": {"type": "string"},
        "admin_password_key": {"type": "string"},
        "host": {"type": "string"},
        "port": {"type": ["string", "integer"]}
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {"properties": {"runtime": {"enum": ["docker", "mixed"]}}},
      "then": {"required": ["image"]}
    },
    {
      "if": {"properties": {"runtime": {"enum": ["native", "systemd", "launchd"]}}},
      "then": {"required": ["artifact", "install_path"]}
    }
  ]
}
