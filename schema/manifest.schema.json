{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "app", "zone", "runtime", "stack_path", "data_path", "secret_path", "secret_mount", "required_secrets", "healthcheck"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "app": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "zone": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "image": {"type": "string"},
    "kind": {"type": "string"},
    "runtime": {"enum": ["native", "docker", "systemd", "launchd", "mixed", "none"]},
    "release_source": {"type": "string", "pattern": "^(https://github\\.com/)?[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"},
    "release_channel": {"enum": ["stable", "prerelease"]},
    "current_version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "release_asset_pattern": {"type": "string"},
    "image_template": {"type": "string"},
    "cli": {
      "type": "object",
      "required": ["name", "commands"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "helper": {
      "type": "object",
      "required": ["asset_pattern", "label", "server", "test_server"],
      "properties": {
        "asset_pattern": {"type": "string"},
        "label": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "server": {"type": "string", "format": "uri"},
        "test_server": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "menu_bar": {
      "type": "object",
      "required": ["asset_pattern", "label"],
      "properties": {
        "asset_pattern": {"type": "string"},
        "label": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      },
      "additionalProperties": false
    },
    "mac_runtime": {
      "type": "object",
      "required": ["asset_pattern", "label", "server", "data_dir", "port"],
      "properties": {
        "asset_pattern": {"type": "string"},
        "label": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "server": {"type": "string", "format": "uri"},
        "data_dir": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      },
      "additionalProperties": false
    },
    "compose_source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "stack_path": {"type": "string"},
    "data_path": {"type": "string"},
    "secret_path": {"type": "string"},
    "secret_mount": {"type": "string"},
    "compose_source": {"type": "string"},
    "install_path": {"type": "string"},
    "service_name": {"type": "string"},
    "service_user": {"type": "string"},
    "working_directory": {"type": "string"},
    "install_command": {"type": "array", "items": {"type": "string"}},
    "upgrade_command": {"type": "array", "items": {"type": "string"}},
    "migration_command": {"type": "array", "items": {"type": "string"}},
    "artifact": {
      "type": "object",
      "required": ["url", "sha256"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "required_secrets": {"type": "array", "items": {"type": "string"}},
    "generated_secrets": {"type": "array", "items": {"type": "object", "required": ["name", "length"]}},
    "healthcheck": {"type": "object", "required": ["url"]},
    "postgres": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["shared", "dedicated", "private"]},
        "cluster": {"type": "string"},
        "cluster_name": {"type": "string"},
        "infrastructure_compose_path": {"type": "string"},
        "network_name": {"type": "string"},
        "service_name": {"type": "string"},
        "app_role": {"type": "string"},
        "app_database": {"type": "string"},
        "admin_compose_path": {"type": "string"},
        "admin_secret_path": {"type": "string"},
        "service": {"type": "string"},
        "admin_user": {"type": "string"},
        "admin_database": {"type": "string"},
        "role": {"type": "string"},
        "database": {"type": "string"},
        "role_password_key": {"type": "string"},
        "database_url_key": {"type": "string"},
        "admin_password_key": {"type": "string"},
        "host": {"type": "string"},
        "port": {"type": ["string", "integer"]},
        "postgres_major": {"type": "string", "pattern": "^[0-9]+$"},
        "data_path": {"type": "string"}
      }
    },
    "allOf": [
      {
        "if": {"properties": {"mode": {"const": "shared"}}},
        "then": {
          "required": [
            "cluster_name",
            "infrastructure_compose_path",
            "service_name",
            "network_name",
            "admin_user",
            "admin_database",
            "admin_secret_path",
            "admin_password_key",
            "app_role",
            "app_database",
            "role_password_key",
            "database_url_key"
          ]
        }
      }
    ]
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": ["kind"],
        "properties": {"kind": {"const": "application"}}
      },
      "then": {"required": ["cli"]}
    },
    {
      "if": {"properties": {"runtime": {"enum": ["docker", "mixed"]}}},
      "then": {"required": ["image"]}
    },
    {
      "if": {"properties": {"runtime": {"enum": ["native", "systemd", "launchd"]}}},
      "then": {"required": ["artifact", "install_path"]}
    },
    {
      "if": {"required": ["release_source"]},
      "then": {"required": ["current_version"]}
    }
  ]
}
