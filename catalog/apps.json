{
  "schema_version": "1",
  "apps": {
    "mytask": {
      "schema_version": "1.0",
      "kind": "application",
      "app": "mytask",
      "zone": "apps",
      "runtime": "docker",
      "release_source": "dimark57/mytask",
      "release_channel": "stable",
      "current_version": "v0.1.63",
      "image_template": "ghcr.io/dimark57/mytask:{tag}",
      "image": "ghcr.io/dimark57/mytask:v0.1.63",
      "stack_path": "/srv/nas/stacks/utilites/mytask",
      "data_path": "/srv/nas/data/mythings",
      "secret_path": "/srv/nas/secrets/mytask.env",
      "secret_mount": "/run/mytask.env",
      "compose_source_url": "https://raw.githubusercontent.com/dimark57/mytask/main/deploy/bootstrap/stack-compose.yml",
      "required_secrets": ["DATABASE_URL"],
      "generated_secrets": [],
      "healthcheck": {
        "url": "http://127.0.0.1:8090/api/health",
        "timeout_seconds": 60,
        "retries": 5
      },
      "cli": {
        "name": "mytask",
        "commands": [
          "--version",
          "--help",
          "--man",
          "--doctor",
          "--update",
          "repo"
        ]
      },
      "postgres": {
        "mode": "shared",
        "cluster_name": "nas-main",
        "infrastructure_compose_path": "/srv/nas/stacks/infrastructure/postgres/compose.yml",
        "service_name": "postgres",
        "network_name": "nas-infra",
        "admin_user": "postgres",
        "admin_database": "postgres",
        "admin_secret_path": "/srv/nas/secrets/postgres.env",
        "admin_password_key": "POSTGRES_PASSWORD",
        "app_role": "mythings",
        "app_database": "mythings",
        "role_password_key": "DATABASE_PASSWORD",
        "database_url_key": "DATABASE_URL",
        "host": "postgres",
        "port": "5432"
      }
    },
    "mytask_mac": {
      "schema_version": "1.0",
      "kind": "application",
      "app": "mytask_mac",
      "zone": "local",
      "runtime": "native",
      "release_source": "dimark57/mytask",
      "release_channel": "stable",
      "current_version": "v0.1.63",
      "release_asset_pattern": "mytask-mac-{version}-source.zip",
      "install_path": "/srv/nas/stacks/utilites/mytask_mac/releases/current/mytask_mac",
      "stack_path": "/srv/nas/stacks/utilites/mytask_mac",
      "data_path": "~/Library/Application Support/mytask_mac",
      "secret_path": "/srv/nas/secrets/mytask_mac.env",
      "secret_mount": "/run/mytask_mac.env",
      "required_secrets": [],
      "generated_secrets": [],
      "healthcheck": {
        "url": "http://127.0.0.1:8091/api/health",
        "timeout_seconds": 10,
        "retries": 3
      },
      "cli": {
        "name": "mytask_mac",
        "commands": ["--version", "--help"]
      },
      "mac_runtime": {
        "asset_pattern": "mytask-mac-{version}-source.zip",
        "label": "com.mytask.mac",
        "server": "https://mytask.digials.com",
        "data_dir": "~/Library/Application Support/mytask_mac",
        "port": 8091
      }
    },
    "myqa": {
      "schema_version": "1.0",
      "kind": "application",
      "app": "myqa",
      "zone": "apps",
      "runtime": "native",
      "release_source": "dimark57/myqa",
      "release_channel": "stable",
      "current_version": "v0.1.0",
      "release_asset_pattern": "myqa-{version}-{platform}",
      "artifact": {
        "url": "https://github.com/dimark57/myqa/releases/download/v0.1.0/myqa-v0.1.0-linux-amd64",
        "sha256": "a83fe2ad8b455f9a493cdf689e9a329c11253731fe7e80acdbfd5e9959560654"
      },
      "install_path": "/srv/nas/stacks/apps/myqa/releases/current/myqa",
      "stack_path": "/srv/nas/stacks/utilites/myqa",
      "data_path": "/srv/nas/data/myqa",
      "secret_path": "/srv/nas/secrets/myqa.env",
      "secret_mount": "/run/myqa.env",
      "required_secrets": [],
      "generated_secrets": [],
      "healthcheck": {
        "url": "http://127.0.0.1:0/health",
        "timeout_seconds": 5,
        "retries": 1
      },
      "cli": {
        "name": "myqa",
        "commands": [
          "--version",
          "--help",
          "--man",
          "--doctor",
          "--update",
          "help",
          "man",
          "doctor",
          "update"
        ]
      }
    }
  }
}
